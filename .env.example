# ---------------------------------------------------------------------------
# Kate Iverson Media — environment variables
#
# HOW TO USE:
#   1. Make a copy of this file in the project root and name it ".env.local"
#   2. Fill in the real values below
#   3. Add the same values in Vercel: Project Settings > Environment Variables
#
# ".env.local" is ignored by git, so real keys never get committed.
# ---------------------------------------------------------------------------

# Web3Forms access key — this is what emails the contact form to Kate.
# Get a free key in ~30 seconds at https://web3forms.com (enter the email
# address where submissions should land; they email you the key).
#
# Note: this key is designed to be public (it only allows sending mail to the
# address it was created with), which is why it uses the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here

# The public URL of the live site. Used for SEO metadata, sitemap, and
# social share previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kateiversonmedia.com

# Supabase project URL used to build public portfolio video URLs.
# Use the public Storage bucket named `website-videos-public`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key for browser and cookie-based SSR auth.
# This is safe to expose to the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-only Supabase secret key used by verified Stripe/Documenso webhooks.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ---------------------------------------------------------------------------
# Kate backend integrations — server-only values
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# Only Price IDs listed here can be invoiced from the dashboard. Product names
# and amounts are retrieved from Stripe at request time.
STRIPE_PRICE_CATALOG_JSON='[{"key":"starter","label":"Starter","priceId":"price_your-id-here","scopeSummary":"Monthly social media support for one platform, including content planning, caption writing, scheduling, 8 feed posts, and 2 short-form videos."}]'

DOCUMENSO_API_TOKEN=api_your-token-here
DOCUMENSO_TEMPLATE_ENVELOPE_ID=envelope_cribrefhtbcynofl
DOCUMENSO_WEBHOOK_SECRET=your-webhook-secret-here
DOCUMENSO_SIGNER_RECIPIENT_ID=3718700

# Field IDs and types from the Documenso template envelope. Signature, name,
# and signing-date fields are retained for Documenso/signer completion and are
# not sent as ordinary prefilled values by the backend.
DOCUMENSO_PREFILL_FIELDS_JSON='{"client_name":{"fieldId":18435137,"type":"text"},"company_name":{"fieldId":18435143,"type":"text"},"package_name":{"fieldId":18435153,"type":"text"},"service_fee":{"fieldId":18435157,"type":"text"},"service_start_date":{"fieldId":18435161,"type":"text"},"scope_summary":{"fieldId":18435229,"type":"text"},"client_signature":{"fieldId":18435230,"type":"signature"},"date_signed":{"fieldId":18435231,"type":"date"},"printed_client_name":{"fieldId":18435237,"type":"name"},"signature_company_name":{"fieldId":18435247,"type":"text"}}'
